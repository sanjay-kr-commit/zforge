#!/bin/env zsh

export _zforge_pid_="$$"
export _zforge_root_="$( dirname -- $( dirname -- $(dirname -- $(realpath ${(%):-%N}))))"
export _session_id_="$EPOCHREALTIME"

if [[ -d "/dev/shm" ]] ; then
  export _log_dir_="/dev/shm/logger"
else
  export _log_dir_="$_zforge_root_/cache/generated/runtime/logger"
fi

# load runtime flags
if [[ -f "$_zforge_root_/local/public/runtime/bootflags" ]] ; then
  while read -r flag ; do
    [[ -z "$flag" ]] && continue
    eval "export $flag=1"
  done <"$_zforge_root_/local/public/runtime/bootflags"
else
  # default flags
  export LOGALL=1
  export SILENT_LOG=1
fi
