#!/bin/env zsh

[[ -d "$_zforge_root_/cache/generated/runtime/" ]] || mkdir "$_zforge_root_/cache/generated/runtime"
[[ -f "$_zforge_root_/cache/generated/runtime/shell_api_stub_temp" ]] && rm "$_zforge_root_/cache/generated/runtime/shell_api_stub_temp"

echo "# $livehash" > "$_zforge_root_/cache/generated/runtime/shell_api_stub_$_session_id_"

for file in "$_zforge_root_/runtime/shell_api/"* ; do
  [[ "$file" == "$_zforge_root_/runtime/shell_api/IGNORE_FINGERPRINTING" ]] && continue
  "$_zforge_root_/runtime/generator/helper/lazyWrapperGenerator" "$file" >> "$_zforge_root_/cache/generated/runtime/shell_api_stub_$_session_id_"
done

mv "$_zforge_root_/cache/generated/runtime/shell_api_stub_$_session_id_" "$_zforge_root_/cache/generated/runtime/shell_api_stub"
