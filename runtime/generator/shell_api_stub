#!/bin/env zsh

[[ -d $_dot_bootstrap_root_/cache/ ]] || mkdir $_dot_bootstrap_root_/cache
[[ -f $_dot_bootstrap_root_/cache/shell_api_stub_temp ]] && rm $_dot_bootstrap_root_/cache/shell_api_stub_temp

echo "# $livehash" > $_dot_bootstrap_root_/cache/shell_api_stub_temp

for file in $_dot_bootstrap_root_/runtime/shell_api/* ; do 
  $_dot_bootstrap_root_/runtime/generator/helper/lazyWrapperGenerator $file  >> $_dot_bootstrap_root_/cache/shell_api_stub_temp
done

mv $_dot_bootstrap_root_/cache/shell_api_stub_temp $_dot_bootstrap_root_/cache/shell_api_stub
