#!/bin/env zsh
cp "$_zforge_root_/runtime/share/selected_snapshot" "$_zforge_root_/cache/generated/runtime/selected_snapshot"
echo '#!/bin/env zsh
source "$_zforge_root_/cache/generated/runtime/selected_snapshot"
[[ -f "$_zforge_root_/local/public/runtime/flags" ]] && {
  while read -r flag ; do
    [[ -z "$flag" ]] && continue
    eval "export $flag=1"
  done <"$_zforge_root_/local/public/runtime/flags"
}
source "$_zforge_root_/cache/generated/runtime/$_zforge_active_snapshot_/master"
' >> "$_zforge_root_/cache/generated/runtime/init"
