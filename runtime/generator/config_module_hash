#!/bin/env zsh

count="0"
sort "$_dot_bootstrap_root_/local/public/runtime/module" | while read -r module; do
  [[ -z "$module" ]] && continue
  [[ -f "$_dot_bootstrap_root_/modules/$module" ]] || continue
  count=$(($count+1))
  echo "$count:$module:$( sha256sum "$_dot_bootstrap_root_/modules/$module" | awk '{ print $1}')"
done | { [[ -v EMBED_FILE_ID_FOR_DEBUG ]] && echo "EMBED_FILE_ID_FOR_DEBUG"; cat; } | sha256sum | awk '{ print $1 }'
unset count
