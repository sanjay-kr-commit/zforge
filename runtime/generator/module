#!/bin/env zsh

local index="$( echo $module | awk -F ':' '{ print $1 }' )" 
local name="$( echo $module | awk -F ':' '{ print $2 }' )"
local hash="$( echo $module | awk -F ':' '{ print $3 }' )"

[[ -d "$_zforge_root_/cache/generated/runtime/$_session_id_/scripts/$index" ]] || mkdir -p "$_zforge_root_/cache/generated/runtime/$_session_id_/scripts/$index"

echo "[generator/module] generation required for module $name" | debug

#[[ "$("$_zforge_root_/runtime/analyzer/is_script_parsable" "$_zforge_root_/modules/$name")" ]] || {
#  echo "[generator/module] script $name failed to load" | error
#  return
#}

priority="$( source "$_zforge_root_/runtime/generator/helper/extract_priority" "$_zforge_root_/modules/$name" )"

[[ "$priority" == "!" ]] && {
  generation_error="[generator/helper/extract_priority] module $name : more then one priority_present '$priority_present'"
  return 
}

[[ -z "$priority" ]] || {
  echo "[generator/module] priority of $name : $priority" | debug
  echo "$index:$priority" >> "$_zforge_root_/cache/generated/runtime/$_session_id_/pmodule"
}

flags="$( "$_zforge_root_/runtime/generator/helper/extract_flags" "$_zforge_root_/modules/$name" )"

[[ -z "$flags" ]] || {
  echo "[generator/module] flags found for $name : $(echo $flags | tr '\n' ' ' )" | debug
  [[ -f "$_zforge_root_/cache/generated/runtime/$_session_id_/scripts/$index/flags" ]] && rm "$_zforge_root_/cache/generated/runtime/$_session_id_/scripts/$index/flags"
  echo "$flags" > "$_zforge_root_/cache/generated/runtime/$_session_id_/scripts/$index/flags"
}

dependencies="$( "$_zforge_root_/runtime/generator/helper/extract_dependencies" "$_zforge_root_/modules/$name" )"

[[ -z "$dependencies" ]] || {
  echo "[generator/module] dependencies found for $name : $(echo $dependencies | tr '\n' ' ' )" | debug
  [[ -f "$_zforge_root_/cache/generated/runtime/$_session_id_/scripts/$index/dependencies" ]] && rm "$_zforge_root_/cache/generated/runtime/$_session_id_/scripts/$index/dependencies"
  echo "$dependencies" > "$_zforge_root_/cache/generated/runtime/$_session_id_/scripts/$index/dependencies"
}

env="$( "$_zforge_root_/runtime/generator/helper/extract_env" "$_zforge_root_/modules/$name" )"

[[ -z "$env" ]] || {
  echo "[generator/module] env found for $name : $(echo $env | tr '\n' ' ' )" | debug
  [[ -f "$_zforge_root_/cache/generated/runtime/$_session_id_/scripts/$index/env" ]] && rm "$_zforge_root_/cache/generated/runtime/$_session_id_/scripts/$index/env"
  echo "$env" > "$_zforge_root_/cache/generated/runtime/$_session_id_/scripts/$index/env"
}

[[ -z "$( "$_zforge_root_/runtime/generator/helper/extract_nomerge" "$_zforge_root_/modules/$name" )" ]] || {
  echo "[generator/module] module '$name' : this module shouldn't be merged" | debug
  touch "$_zforge_root_/cache/generated/runtime/$_session_id_/scripts/$index/nomerge"
}


grep -q '^# *@nolazy' "$_zforge_root_/modules/$name" && {
  echo "[generator/module] copying $name @nolazy tag found" | debug
  cat "$_zforge_root_/modules/$name" | "$_zforge_root_/runtime/generator/helper/remove_space_and_comment" > "$_zforge_root_/cache/generated/runtime/$_session_id_/scripts/$index/main"
  return
}

grep -q '^# *@lazy' "$_zforge_root_/modules/$name" && {
  echo "[generator/module] generating lazy stub for $name @lazy tag found" | debug
  cat "$_zforge_root_/modules/$name" | "$_zforge_root_/runtime/generator/helper/remove_space_and_comment" > "$_zforge_root_/cache/generated/runtime/$_session_id_/scripts/$index/lazy"
  "$_zforge_root_/runtime/generator/helper/lazyWrapperGenerator" "$_zforge_root_/cache/generated/runtime/$_session_id_/scripts/$index/lazy" > "$_zforge_root_/cache/generated/runtime/$_session_id_/scripts/$index/main"
  return
}

echo "[generator/module] doing automatic optimization" | debug
local -a lazy_funcs
lazy_funcs=( ${(f)"$("$_zforge_root_/runtime/analyzer/lazy_funcs" "$_zforge_root_/modules/$name")"} )

[[ -z $lazy_funcs ]] && {
  echo "[generator/module] no lazy func found copying $name" | debug
  cat "$_zforge_root_/modules/$name" | "$_zforge_root_/runtime/generator/helper/remove_space_and_comment" > "$_zforge_root_/cache/generated/runtime/$_session_id_/scripts/$index/main"
  return
}

echo "[generator/module] lazy func found for $name : $lazy_funcs" | debug
"$_zforge_root_/runtime/generator/helper/extract_func" "$_zforge_root_/modules/$name" "${lazy_funcs[@]}" | "$_zforge_root_/runtime/generator/helper/remove_space_and_comment" > "$_zforge_root_/cache/generated/runtime/$_session_id_/scripts/$index/lazy_funcs"
if [[ -f "$_zforge_root_/cache/generated/runtime/$_session_id_/scripts/$index/nomerge" ]] ; then
  head -n1 "$_zforge_root_/modules/$name" > "$_zforge_root_/cache/generated/runtime/$_session_id_/scripts/$index/main"
  "$_zforge_root_/runtime/generator/helper/lazyWrapperGenerator" "$_zforge_root_/cache/generated/runtime/$_session_id_/scripts/$index/lazy_funcs" >> "$_zforge_root_/cache/generated/runtime/$_session_id_/scripts/$index/main"
  "$_zforge_root_/runtime/generator/helper/remove_func" "$_zforge_root_/modules/$name" "${lazy_funcs[@]}" | "$_zforge_root_/runtime/generator/helper/remove_space_and_comment" >> "$_zforge_root_/cache/generated/runtime/$_session_id_/scripts/$index/main"
else
  "$_zforge_root_/runtime/generator/helper/lazyWrapperGenerator" "$_zforge_root_/cache/generated/runtime/$_session_id_/scripts/$index/lazy_funcs" > "$_zforge_root_/cache/generated/runtime/$_session_id_/scripts/$index/main"
  "$_zforge_root_/runtime/generator/helper/remove_func" "$_zforge_root_/modules/$name" "${lazy_funcs[@]}" | "$_zforge_root_/runtime/generator/helper/remove_space_and_comment" >> "$_zforge_root_/cache/generated/runtime/$_session_id_/scripts/$index/main"
fi
