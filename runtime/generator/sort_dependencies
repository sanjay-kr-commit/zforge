local detectCycle() {
  echo "${detectCyclePath[@]}" | grep -q ":$1:" && {
    detectCyclePath+=("-> :$1:")
    echo "[generator/sort_dependencies] cycle detected" | error
    echo "[generator/sort_dependencies] \"${detectCyclePath[@]}\"" | error
    generation_error="[generator/sort_dependencies] cycle detected : \"${detectCyclePath[@]}\""
    return
  }
  detectCyclePath+=("-> :$1:")
  for dependentModule in ${(f)mapValue[$1]}; do
    detectCycle "$dependentModule"
    [[ -z $generation_error ]] || {
      return
    }
  done
}

[[ -v detectCyclePath ]] && unset detectCyclePath
for module in "${mapKey[@]}"; do
  typeset -a detectCyclePath
  detectCycle "$module"
  unset detectCyclePath
  [[ -z $generation_error ]] || {
    unset detectCycle
    return
  }
done

unset detectCycle

