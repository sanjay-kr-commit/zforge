#!/bin/env zsh

[[ -v mapKey ]] && unset mapKey
[[ -v mapValue ]] && unset mapValue

typeset -a mapKey
typeset -A mapValue

while read -r dependencies ; do 
  moduleIndex="${dependencies#$_dot_bootstrap_root_/generated/$_session_id_/scripts/}"
  moduleIndex="${moduleIndex%/dependencies}"
  moduleName="$( grep "^$moduleIndex:.*" "$_dot_bootstrap_root_/generated/$_session_id_/module" | awk -F ':' '{ print $2 }' )"
  mapKey+=("$moduleName")
  mapValue[$moduleName]="$( cat $dependencies )"
done < <( find $_dot_bootstrap_root_/generated/$_session_id_/scripts -type f -name 'dependencies')

