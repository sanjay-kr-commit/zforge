#!/bin/env zsh

local livehash=$(sha256sum < <(while read -r line; do
  sha256sum $_dot_bootstrap_root_/runtime/shell_api/$line
done < <(ls $_dot_bootstrap_root_/runtime/shell_api | sort )) | awk '{ print $1 }')

[[ -f $_dot_bootstrap_root_/cache/shell_api_stub ]] || {
  echo "[fingerprint/module/shell_api_stub] shell_api_stub not found generating stub" | warn
  source $_dot_bootstrap_root_/runtime/generator/shell_api_stub
  return
}

local lasthash="$(head -n1 $_dot_bootstrap_root_/cache/shell_api_stub | sed -e 's/^ *# *//g' )"

[[ $livehash == $lasthash ]] || {
  echo "[fingerprint/module/shell_api_stub] shell_api_stub hash changed" | debug
  echo "[fingerprint/module/shell_api_stub] livehash : $livehash" | debug
  echo "[fingerprint/module/shell_api_stub] lastHash : $lasthash" | debug
  source $_dot_bootstrap_root_/runtime/generator/shell_api_stub
}
