#!/bin/env zsh

source $(dirname -- $(realpath ${(%):-%N}))/initialize/env 
source $_dot_bootstrap_root_/runtime/initialize/init_logger

echo "root dir : $_dot_bootstrap_root_" | debug
echo "session id : $_session_id_" | debug
echo "$_session_id_" 

source $_dot_bootstrap_root_/runtime/fingerprint/main

source $_dot_bootstrap_root_/runtime/loaders/loadCommands
 
if [[ -f "$_dot_bootstrap_root_/cache/init" ]]; then
  source "$_dot_bootstrap_root_/cache/init"
else
  echo "[init] $_dot_bootstrap_root_/cache/init not found" | error
fi

if [[ $1 == "--log" ]]; then
  :log
fi
